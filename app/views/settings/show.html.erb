<% content_for :title, "Settings | Syncretica" %>

<%= turbo_stream_from GenerateAllEmbeddingsJob::STREAM_NAME %>

<div class="w-full max-w-4xl mx-auto space-y-8 pb-16">
  <header class="border-b border-slate-200 pb-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Settings</h1>
    <p class="mt-2 text-sm text-slate-600">
      Inspect embedding configuration and bulk-generate vector embeddings for Gods and Myths.
    </p>
  </header>

  <% if notice.present? %>
    <p role="status" class="rounded-md border border-indigo-200 bg-indigo-50 px-4 py-2.5 text-sm font-medium text-indigo-800">
      <%= notice %>
    </p>
  <% end %>

  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
    <h2 class="text-base font-semibold text-slate-900">Embedding Configuration</h2>
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3 text-sm">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Model</dt>
        <dd class="mt-1 font-mono text-xs text-slate-900"><%= @embedding_config[:model] %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">API Base</dt>
        <dd class="mt-1 font-mono text-xs text-slate-900 break-all"><%= @embedding_config[:api_base] %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Dimensions</dt>
        <dd class="mt-1 text-xs font-medium text-slate-900"><%= @embedding_config[:dimensions] %></dd>
      </div>
    </dl>
  </section>

  <!-- LLM Chat & Context Window Configuration -->
  <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 border-b border-slate-100 pb-3">
      <div>
        <h2 class="text-base font-semibold text-slate-900">LLM Chat &amp; Context Window Configuration</h2>
        <p class="text-xs text-slate-500 mt-0.5">
          Controls the token budget used by agents and dynamically scales snapshot digest size for reports.
        </p>
      </div>
      <div class="text-xs font-mono bg-indigo-50 text-indigo-700 px-2.5 py-1 rounded-md border border-indigo-200">
        Current Window: <strong><%= number_with_delimiter(@llm_config[:context_window]) %> tokens</strong>
      </div>
    </div>

    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3 text-sm">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Configured Model</dt>
        <dd class="mt-1 font-mono text-xs text-slate-900"><%= @llm_config[:model].presence || "Not set (ENV['OLLAMA_MODEL'])" %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">API Base</dt>
        <dd class="mt-1 font-mono text-xs text-slate-900 break-all"><%= @llm_config[:api_base].presence || "http://localhost:11434/v1" %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wider text-slate-500">Report Digest Budget</dt>
        <dd class="mt-1 text-xs font-medium text-slate-900">
          ~<%= number_with_delimiter(@llm_config[:digest_char_budget]) %> chars
          <span class="text-slate-400 font-normal">(~<%= number_with_delimiter(@llm_config[:digest_char_budget] / 4) %> tokens)</span>
        </dd>
      </div>
    </dl>

    <div class="rounded-lg bg-slate-50 p-4 border border-slate-200 space-y-3">
      <div class="flex items-center justify-between">
        <label class="text-xs font-bold uppercase tracking-wider text-slate-700">
          Adjust Context Window
        </label>
        <span class="text-[11px] text-slate-500">Higher windows accommodate larger cluster digests without truncating member themes.</span>
      </div>

      <!-- Quick Preset Buttons -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs text-slate-500 font-medium">Quick Presets:</span>
        <% @llm_config[:presets].each do |preset| %>
          <%= button_to update_context_window_settings_path(context_window: preset[:tokens]),
                        method: :patch,
                        class: [
                          "rounded-md px-2.5 py-1 text-xs font-medium border transition cursor-pointer",
                          @llm_config[:context_window] == preset[:tokens] ? "bg-indigo-600 text-white border-indigo-600 shadow-xs" : "bg-white text-slate-700 border-slate-300 hover:bg-slate-100"
                        ].join(" ") do %>
            <%= preset[:label] %> (<%= number_with_delimiter(preset[:tokens]) %>)
          <% end %>
        <% end %>
      </div>

      <!-- Custom Token Form -->
      <%= form_with url: update_context_window_settings_path, method: :patch, local: true, class: "flex items-center gap-3 pt-2" do |f| %>
        <div class="flex-1 max-w-xs">
          <%= f.number_field :context_window,
                             value: @llm_config[:context_window],
                             min: 4096,
                             step: 1024,
                             class: "w-full rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-900 shadow-inner focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 font-mono" %>
        </div>
        <%= f.submit "Update Custom Window", class: "rounded-md bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-indigo-500 cursor-pointer transition" %>
      <% end %>
    </div>
  </section>

  <div class="space-y-6">
    <%= render "settings/embedding_section",
               model_type: "God",
               stats: @god_stats,
               running: false %>

    <%= render "settings/embedding_section",
               model_type: "Myth",
               stats: @myth_stats,
               running: false %>
  </div>
</div>
