<div id="clusters_content" class="space-y-8">
  <!-- Stats Metric Bar -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Embedded <%= @result.target_name %></div>
      <div class="mt-1 text-2xl font-bold text-slate-900"><%= @result.total_embedded_count %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Clusters Formed</div>
      <div class="mt-1 text-2xl font-bold text-indigo-600"><%= @result.multi_clusters_count %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Largest Cluster</div>
      <div class="mt-1 text-2xl font-bold text-slate-900"><%= @result.largest_cluster_size %> <span class="text-xs font-normal text-slate-500">items</span></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Unclustered Singletons</div>
      <div class="mt-1 flex items-baseline gap-2">
        <span class="text-2xl font-bold <%= @result.singletons_count.zero? ? 'text-emerald-600' : 'text-slate-600' %>">
          <%= @result.singletons_count %>
        </span>
        <% if @result.singletons_count.zero? %>
          <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">
            100% Clustered
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @result.clusters.none? %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <h3 class="mt-4 text-base font-semibold text-slate-900">No multi-member clusters at Level <%= @result.level %></h3>
      <p class="mt-1 text-sm text-slate-500">
        The similarity threshold (distance &le; <%= @result.distance_threshold %>) is very strict. Move the slider to a higher number to relax similarity and uncover broader syncretic groupings.
      </p>
    </div>
  <% else %>
    <!-- Clusters Grid -->
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900">
          Archetype Clusters (<%= @result.multi_clusters_count %>)
        </h2>
        <span class="text-xs text-slate-500">
          Ranked by cluster size &bull; Cosine distance threshold &le; <%= @result.distance_threshold %><%= " &bull; Complete Coverage (0 Singletons)".html_safe if @result.full_coverage? %>
        </span>
      </div>

      <div class="space-y-5">
        <% @result.clusters.each do |cluster| %>
          <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:border-slate-300">
            <!-- Cluster Header -->
            <div class="border-b border-slate-100 bg-slate-50/75 px-5 py-4 sm:flex sm:items-center sm:justify-between">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center rounded-md bg-indigo-100 px-2.5 py-0.5 text-xs font-bold text-indigo-800">
                    Cluster #<%= cluster.id %>
                  </span>
                  <h3 class="text-base font-bold text-slate-900">
                    <%= cluster.name %>
                  </h3>
                  <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
                    <%= pluralize(cluster.size, "member") %>
                  </span>
                </div>

                <% if cluster.shared_themes.any? %>
                  <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    <span class="text-xs font-medium text-slate-400">Key Themes:</span>
                    <% cluster.shared_themes.each do |theme| %>
                      <span class="inline-flex items-center rounded-md border border-indigo-200 bg-indigo-50/60 px-2 py-0.5 text-xs font-medium text-indigo-700">
                        <%= theme %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <!-- Pantheons badges -->
              <div class="mt-3 sm:mt-0 flex flex-wrap gap-1 items-center justify-end">
                <span class="text-xs text-slate-400 mr-1">Pantheons:</span>
                <% cluster.pantheons.each do |pantheon| %>
                  <span class="inline-flex items-center rounded-full bg-slate-200/70 px-2 py-0.5 text-[11px] font-medium text-slate-700">
                    <%= pantheon %>
                  </span>
                <% end %>
              </div>
            </div>

            <!-- Members List -->
            <div class="divide-y divide-slate-100 p-2 sm:p-4">
              <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3">
                <% cluster.records.each do |record| %>
                  <% if record.is_a?(God) %>
                    <div class="flex flex-col justify-between rounded-lg border border-slate-100 bg-slate-50/40 p-3 hover:bg-slate-50 transition">
                      <div>
                        <div class="flex items-center justify-between gap-2">
                          <%= link_to record.name, god_path(record), data: { turbo_frame: "cluster_modal" }, class: "font-semibold text-sm text-indigo-600 hover:text-indigo-500 hover:underline" %>
                          <span class="inline-flex items-center rounded-full bg-slate-200/80 px-2 py-0.5 text-[10px] font-medium text-slate-700">
                            <%= record.pantheon&.name %>
                          </span>
                        </div>
                        <p class="mt-1 text-xs text-slate-600 line-clamp-2">
                          <%= record.description %>
                        </p>
                      </div>
                      <div class="mt-2.5 flex items-center justify-between gap-2 pt-2 border-t border-slate-100">
                        <% if record.themes.any? %>
                          <div class="flex flex-wrap gap-1">
                            <% record.themes.take(2).each do |theme| %>
                              <span class="inline-flex items-center rounded bg-white px-1.5 py-0.5 text-[10px] text-slate-600 border border-slate-200">
                                <%= theme %>
                              </span>
                            <% end %>
                            <% if record.themes.size > 2 %>
                              <span class="text-[10px] text-slate-400">+<%= record.themes.size - 2 %></span>
                            <% end %>
                          </div>
                        <% else %>
                          <div></div>
                        <% end %>
                        <%= link_to "View details →", god_path(record), data: { turbo_frame: "cluster_modal" }, class: "text-[11px] font-semibold text-indigo-600 hover:text-indigo-800 whitespace-nowrap ml-auto" %>
                      </div>
                    </div>
                  <% elsif record.is_a?(Myth) %>
                    <div class="flex flex-col justify-between rounded-lg border border-slate-100 bg-slate-50/40 p-3 hover:bg-slate-50 transition">
                      <div>
                        <div class="flex items-center justify-between gap-2">
                          <%= link_to "#{record.god&.name} Myth", myth_path(record), data: { turbo_frame: "cluster_modal" }, class: "font-semibold text-sm text-indigo-600 hover:text-indigo-500 hover:underline" %>
                          <span class="inline-flex items-center rounded-full bg-slate-200/80 px-2 py-0.5 text-[10px] font-medium text-slate-700">
                            <%= record.god&.pantheon&.name %>
                          </span>
                        </div>
                        <% if record.themes.is_a?(Hash) %>
                          <div class="mt-2 space-y-1">
                            <% record.themes.take(2).each do |title, desc| %>
                              <div class="text-xs">
                                <span class="font-medium text-slate-800"><%= title %>:</span>
                                <span class="text-slate-600 line-clamp-1"><%= desc %></span>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                      <div class="mt-2.5 flex items-center justify-end pt-2 border-t border-slate-100">
                        <%= link_to "View details →", myth_path(record), data: { turbo_frame: "cluster_modal" }, class: "text-[11px] font-semibold text-indigo-600 hover:text-indigo-800 whitespace-nowrap" %>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Unclustered Singletons Accordion -->
  <% if @result.singletons.any? %>
    <details class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition">
      <summary class="flex cursor-pointer items-center justify-between font-semibold text-slate-800 hover:text-indigo-600">
        <div class="flex items-center gap-2">
          <span>Unclustered <%= @result.target_name %> (<%= @result.singletons_count %>)</span>
          <span class="text-xs font-normal text-slate-500">
            Entities with no neighbors within distance &le; <%= @result.distance_threshold %>
          </span>
        </div>
        <svg class="h-5 w-5 text-slate-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="mt-4 border-t border-slate-100 pt-4">
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
          <% @result.singletons.each do |record| %>
            <div class="rounded-lg border border-slate-100 bg-slate-50/60 p-2.5 text-xs hover:bg-slate-100 transition">
              <% if record.is_a?(God) %>
                <div class="font-medium text-slate-900 truncate">
                  <%= link_to record.name, god_path(record), data: { turbo_frame: "cluster_modal" }, class: "hover:text-indigo-600 hover:underline" %>
                </div>
                <div class="text-[11px] text-slate-500 truncate">
                  <%= record.pantheon&.name %>
                </div>
              <% elsif record.is_a?(Myth) %>
                <div class="font-medium text-slate-900 truncate">
                  <%= link_to "#{record.god&.name}", myth_path(record), data: { turbo_frame: "cluster_modal" }, class: "hover:text-indigo-600 hover:underline" %>
                </div>
                <div class="text-[11px] text-slate-500 truncate">
                  <%= record.god&.pantheon&.name %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </details>
  <% end %>
</div>
