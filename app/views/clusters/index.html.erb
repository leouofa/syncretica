<% content_for :title, "Clusters | Syncretica" %>

<div class="w-full max-w-6xl mx-auto space-y-8 pb-16">
  <!-- Header -->
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Embedding Clusters</h1>
      <p class="mt-2 text-sm text-slate-600 max-w-2xl">
        Discover archetypal and mythological connections across pantheons using vector similarity. Adjust the sensitivity slider to shift from twin counterparts to broad cosmic domains and full 100% coverage.
      </p>
    </div>

    <div class="flex items-center gap-3 shrink-0">
      <%= link_to cluster_snapshots_path(target_type: @target_class.name),
                  class: "inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition" do %>
        <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Saved Snapshots (<%= @snapshots.size %>)</span>
      <% end %>

      <!-- Save Snapshot Button / Form Trigger -->
      <button type="button"
              onclick="document.getElementById('snapshot_modal').classList.remove('hidden')"
              class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
        </svg>
        <span>Save Snapshot</span>
      </button>
    </div>
  </header>

  <!-- Notice/Alert if unembedded records -->
  <% if @unembedded_count > 0 %>
    <div class="rounded-xl border border-amber-200 bg-amber-50/70 p-4">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-3 text-amber-800 text-sm">
          <svg class="h-5 w-5 shrink-0 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>
            <strong><%= @unembedded_count %> <%= @result.target_name.downcase %></strong> do not have vector embeddings yet and cannot be clustered.
          </span>
        </div>
        <%= link_to "Generate in Settings", settings_path, class: "rounded-md bg-amber-200/80 px-3 py-1 text-xs font-semibold text-amber-900 hover:bg-amber-300 transition" %>
      </div>
    </div>
  <% end %>

  <!-- Tab Bar & Controls -->
  <div class="space-y-6">
    <div class="border-b border-slate-200">
      <nav class="-mb-px flex space-x-8" aria-label="Tabs">
        <%= link_to clusters_path(tab: "gods", level: @level, full_coverage: @full_coverage),
                    class: [
                      "whitespace-nowrap border-b-2 py-3 px-1 text-sm font-medium transition",
                      @tab == "gods" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700"
                    ].join(" ") do %>
          Deity Clusters (Gods)
        <% end %>

        <%= link_to clusters_path(tab: "myths", level: @level, full_coverage: @full_coverage),
                    class: [
                      "whitespace-nowrap border-b-2 py-3 px-1 text-sm font-medium transition",
                      @tab == "myths" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700"
                    ].join(" ") do %>
          Mythological Theme Clusters (Myths)
        <% end %>
      </nav>
    </div>

    <!-- Range Slider Card -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
         data-controller="cluster-slider"
         data-cluster-slider-tab-value="<%= @tab %>"
         data-cluster-slider-url-value="<%= clusters_path %>">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <label for="similarity_level" class="text-sm font-bold text-slate-900">
            Similarity Granularity (Level 1–15)
          </label>
          <p class="mt-0.5 text-xs text-slate-500">
            Slide to adjust the clustering threshold from strict counterpart twins (1) to complete full-coverage archetypes with 0 singletons (15).
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <!-- Full Coverage Toggle -->
          <label class="inline-flex items-center gap-2 cursor-pointer rounded-lg border border-slate-200 bg-slate-50 px-3 py-1 text-xs font-medium text-slate-700 hover:bg-slate-100 transition">
            <input type="checkbox"
                   data-cluster-slider-target="coverageToggle"
                   data-action="change->cluster-slider#onToggleCoverage"
                   <%= "checked" if @result.full_coverage? %>
                   class="rounded text-indigo-600 focus:ring-indigo-500 h-3.5 w-3.5 border-slate-300">
            <span>Full Coverage (0 Singletons)</span>
          </label>

          <div data-cluster-slider-target="spinner" class="hidden">
            <svg class="h-4 w-4 animate-spin text-indigo-600" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </div>
          <span data-cluster-slider-target="badge" class="inline-flex items-center rounded-full bg-indigo-50 border border-indigo-200 px-3 py-1 text-xs font-semibold text-indigo-700">
            <% if @result.full_coverage? %>
              Level <%= @level %> &bull; Complete Coverage (0 Singletons)
            <% else %>
              Level <%= @level %> &bull; Distance &le; <%= @result.distance_threshold %>
            <% end %>
          </span>
        </div>
      </div>

      <div class="mt-6">
        <input type="range"
               id="similarity_level"
               min="1"
               max="15"
               step="1"
               value="<%= @level %>"
               data-cluster-slider-target="slider"
               data-action="input->cluster-slider#onSlide change->cluster-slider#onChange"
               class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600 focus:outline-none focus:ring-2 focus:ring-indigo-500">

        <!-- Slider Ticks / Guide -->
        <div class="mt-3 flex justify-between text-xs font-medium text-slate-500">
          <span class="flex flex-col items-start">
            <span class="font-bold text-slate-800">1 &bull; Strict</span>
            <span class="text-[11px] text-slate-400">Twin Counterparts (&le;0.16)</span>
          </span>
          <span class="flex flex-col items-center">
            <span class="font-bold text-slate-800">8 &bull; Balanced</span>
            <span class="text-[11px] text-slate-400">Thematic Domains (&le;0.23)</span>
          </span>
          <span class="flex flex-col items-end">
            <span class="font-bold text-slate-800">15 &bull; Full Coverage</span>
            <span class="text-[11px] text-indigo-600 font-semibold">0 Unclustered Singletons</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Turbo Frame for Results -->
  <%= turbo_frame_tag "clusters_content_frame" do %>
    <%= render "results" %>
  <% end %>
</div>

<!-- Modal: Save Cluster Snapshot -->
<div id="snapshot_modal" class="fixed inset-0 z-50 hidden overflow-y-auto bg-slate-900/50 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-xl space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-lg font-bold text-slate-900">Save Cluster Snapshot</h3>
      <button type="button"
              onclick="document.getElementById('snapshot_modal').classList.add('hidden')"
              class="text-slate-400 hover:text-slate-600">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <%= form_with url: snapshot_clusters_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <%= f.hidden_field :tab, value: @tab %>
      <%= f.hidden_field :level, value: @level, id: "modal_snapshot_level" %>
      <%= f.hidden_field :full_coverage, value: @result.full_coverage?, id: "modal_snapshot_full_coverage" %>

      <div>
        <%= f.label :title, "Snapshot Title", class: "block text-sm font-semibold text-slate-700" %>
        <%= f.text_field :title,
                         value: "#{@target_class.name} Clusters - Level #{@level}#{' (Full Coverage)' if @result.full_coverage?} (#{Time.current.strftime('%b %d, %Y')})",
                         required: true,
                         class: "mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-slate-500">
          Will persist <%= @result.multi_clusters_count %> clusters and member assignments for report generation.
        </p>
      </div>

      <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
        <button type="button"
                onclick="document.getElementById('snapshot_modal').classList.add('hidden')"
                class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
          Cancel
        </button>
        <%= f.submit "Save Snapshot",
                     class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition" %>
      </div>
    <% end %>
  </div>
</div>
