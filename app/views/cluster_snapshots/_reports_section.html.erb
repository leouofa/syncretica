<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-6" data-controller="prompt-preset">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-100 pb-4">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-xl font-bold text-slate-900">LLM Archetype & Pattern Reports</h2>
        <%= render "cluster_reports/reports_count", count: reports.size %>
      </div>
      <p class="text-xs text-slate-600 mt-0.5">
        Ask the comparative mythology agent to synthesize cross-cluster patterns, structural motifs, or anomalies across this snapshot's <%= snapshot.clusters_count %> clusters.
      </p>
    </div>

    <div>
      <%= link_to "All Reports Directory &rarr;".html_safe, cluster_reports_path, class: "text-xs font-semibold text-indigo-600 hover:underline" %>
    </div>
  </div>

  <!-- Report Generation Form -->
  <div class="rounded-xl bg-slate-50/70 p-4 border border-slate-200/80 space-y-3">
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
        Preset Inquiries (Click to autofill)
      </label>
      <div class="flex flex-wrap gap-1.5">
        <% ClusterReport::PRESET_PROMPTS.each do |preset| %>
          <button type="button"
                  data-action="click->prompt-preset#selectPreset"
                  data-prompt-preset="<%= preset %>"
                  class="rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-indigo-400 hover:bg-indigo-50/50 hover:text-indigo-700 transition cursor-pointer shadow-2xs text-left">
            &ldquo;<%= preset %>&rdquo;
          </button>
        <% end %>
      </div>
    </div>

    <%= form_with model: [snapshot, new_report], local: true, class: "space-y-3" do |f| %>
      <div>
        <label for="cluster_report_prompt" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
          Research Inquiry / Analytical Prompt
        </label>
        <%= f.text_area :prompt,
                        rows: 3,
                        data: { prompt_preset_target: "promptInput" },
                        placeholder: "e.g., Find interesting patterns across myths or gods...",
                        class: "w-full rounded-lg border border-slate-300 bg-white p-3 text-xs text-slate-900 shadow-inner focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 font-sans" %>
      </div>

      <div class="flex items-center justify-between">
        <p class="text-[11px] text-slate-500">
          Evaluates all <%= snapshot.clusters_count %> clusters and <%= snapshot.items_count %> <%= snapshot.target_type.pluralize.downcase %> in a single-pass context.
        </p>
        <%= f.submit "Generate Report with Agent", class: "rounded-lg bg-indigo-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-indigo-500 transition cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- List of Reports for this Snapshot -->
  <div class="space-y-4 pt-2">
    <div id="snapshot_reports_list" class="space-y-4">
      <% if reports.none? %>
        <div class="rounded-xl border border-dashed border-slate-200 p-8 text-center text-xs text-slate-500">
          No reports generated for this snapshot yet. Choose an inquiry preset above or type your own to run the first comparative analysis.
        </div>
      <% else %>
        <% reports.each do |report| %>
          <%= render "cluster_reports/report_card", report: report, snapshot: snapshot %>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
