<% content_for :title, "Saved Cluster Snapshots | Syncretica" %>

<div class="w-full max-w-6xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <div class="flex items-center gap-2">
        <%= link_to "&larr; Back to Clusters".html_safe, clusters_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-500 hover:underline" %>
      </div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">Saved Cluster Snapshots</h1>
      <p class="mt-1 text-sm text-slate-600">
        Persisted cluster sets and syncretic archetype memberships for cross-pantheon reporting and analysis.
      </p>
    </div>

    <div>
      <%= link_to "New Exploration", clusters_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition" %>
    </div>
  </header>

  <!-- Filter tabs -->
  <div class="border-b border-slate-200">
    <nav class="-mb-px flex space-x-6" aria-label="Target Filter">
      <%= link_to cluster_snapshots_path,
                  class: [
                    "border-b-2 py-2 px-1 text-sm font-medium transition",
                    @target_type.blank? ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700"
                  ].join(" ") do %>
        All Targets (<%= ClusterSnapshot.count %>)
      <% end %>

      <%= link_to cluster_snapshots_path(target_type: "God"),
                  class: [
                    "border-b-2 py-2 px-1 text-sm font-medium transition",
                    @target_type == "God" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700"
                  ].join(" ") do %>
        God Snapshots (<%= ClusterSnapshot.for_target("God").count %>)
      <% end %>

      <%= link_to cluster_snapshots_path(target_type: "Myth"),
                  class: [
                    "border-b-2 py-2 px-1 text-sm font-medium transition",
                    @target_type == "Myth" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700"
                  ].join(" ") do %>
        Myth Snapshots (<%= ClusterSnapshot.for_target("Myth").count %>)
      <% end %>
    </nav>
  </div>

  <% if @snapshots.none? %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <h3 class="text-base font-semibold text-slate-900">No saved snapshots yet</h3>
      <p class="mt-1 text-sm text-slate-500">
        Explore clusters on the Clusters page and click "Save Snapshot" to persist an archetype state.
      </p>
      <div class="mt-4">
        <%= link_to "Explore Clusters", clusters_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition" %>
      </div>
    </div>
  <% else %>
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full divide-y divide-slate-200 text-left">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Snapshot</th>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Target</th>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Granularity</th>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Clusters</th>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Total Items</th>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Reports</th>
            <th class="px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">Created</th>
            <th class="px-5 py-3.5 text-right text-xs font-semibold uppercase tracking-wider text-slate-600">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% @snapshots.each do |snapshot| %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-5 py-4 text-sm font-bold text-slate-900">
                <%= link_to snapshot.title, cluster_snapshot_path(snapshot), class: "text-indigo-600 hover:text-indigo-500 hover:underline" %>
              </td>
              <td class="px-5 py-4 text-sm text-slate-700">
                <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-800">
                  <%= snapshot.target_type %>
                </span>
              </td>
              <td class="px-5 py-4 text-sm text-slate-600">
                Level <%= snapshot.level %> <span class="text-xs text-slate-400">(&le; <%= snapshot.distance_threshold %>)</span>
              </td>
              <td class="px-5 py-4 text-sm font-medium text-slate-900">
                <%= snapshot.clusters_count %>
              </td>
              <td class="px-5 py-4 text-sm text-slate-600">
                <%= snapshot.items_count %>
              </td>
              <td class="px-5 py-4 text-sm text-slate-600">
                <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-700">
                  <%= snapshot.cluster_reports.size %>
                </span>
              </td>
              <td class="px-5 py-4 text-xs text-slate-500">
                <%= snapshot.created_at.strftime("%b %d, %Y %H:%M") %>
              </td>
              <td class="px-5 py-4 text-right text-sm">
                <%= button_to "Delete", cluster_snapshot_path(snapshot), method: :delete, data: { turbo_confirm: "Are you sure you want to delete '#{snapshot.title}'?" }, class: "text-xs font-semibold text-rose-600 hover:text-rose-500 cursor-pointer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
