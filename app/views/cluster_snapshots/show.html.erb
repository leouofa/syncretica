<% content_for :title, "#{@snapshot.title} | Syncretica" %>

<%= turbo_stream_from "cluster_snapshot_#{@snapshot.id}_reports" %>

<div class="w-full max-w-6xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <div class="flex items-center gap-2">
        <%= link_to "&larr; All Snapshots".html_safe, cluster_snapshots_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-500 hover:underline" %>
      </div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><%= @snapshot.title %></h1>
      <p class="mt-1 text-sm text-slate-600">
        Persisted snapshot of <%= @snapshot.target_type %> clusters at Level <%= @snapshot.level %> (distance &le; <%= @snapshot.distance_threshold %>).
      </p>
    </div>

    <div class="flex items-center gap-3">
      <%= button_to "Delete Snapshot", cluster_snapshot_path(@snapshot), method: :delete, data: { turbo_confirm: "Are you sure you want to permanently delete this snapshot?" }, class: "rounded-lg border border-rose-200 bg-white px-3.5 py-2 text-sm font-semibold text-rose-600 shadow-sm hover:bg-rose-50 transition cursor-pointer" %>
    </div>
  </header>

  <!-- Snapshot stats summary -->
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Target Type</div>
      <div class="mt-1 text-xl font-bold text-slate-900"><%= @snapshot.target_type %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Clusters Persisted</div>
      <div class="mt-1 text-xl font-bold text-indigo-600"><%= @snapshot.clusters_count %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Total Items in Scope</div>
      <div class="mt-1 text-xl font-bold text-slate-900"><%= @snapshot.items_count %></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Reports Generated</div>
      <div class="mt-1 text-xl font-bold text-slate-700"><%= @reports.size %></div>
    </div>
  </div>

  <!-- LLM Reports Section -->
  <%= render "cluster_snapshots/reports_section", snapshot: @snapshot, reports: @reports, new_report: @new_report %>

  <!-- Cluster Groups -->
  <div class="space-y-6">
    <h2 class="text-lg font-bold text-slate-900">
      Persisted Archetype Clusters (<%= @cluster_groups.size %>)
    </h2>

    <div class="space-y-4">
      <% @cluster_groups.each_with_index do |group, index| %>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center rounded-md bg-indigo-100 px-2 py-0.5 text-xs font-bold text-indigo-800">
                #<%= index + 1 %>
              </span>
              <h3 class="font-bold text-slate-900 text-base"><%= group.name %></h3>
              <span class="inline-flex items-center rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
                <%= pluralize(group.size, "member") %>
              </span>
            </div>

            <% if group.shared_themes.any? %>
              <div class="flex flex-wrap gap-1.5">
                <% group.shared_themes.each do |theme| %>
                  <span class="inline-flex items-center rounded-md border border-indigo-200 bg-indigo-50/60 px-2 py-0.5 text-xs font-medium text-indigo-700">
                    <%= theme %>
                  </span>
                <% end %>
              </div>
            <% end %>
          </div>

          <!-- Members Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 pt-1">
            <% group.cluster_memberships.each do |membership| %>
              <% record = membership.record %>
              <% next unless record %>
              <div class="rounded-lg border border-slate-100 bg-slate-50/60 p-2.5 text-xs">
                <% if record.is_a?(God) %>
                  <div class="font-semibold text-slate-900 truncate">
                    <%= link_to record.name, god_path(record), data: { turbo_frame: "cluster_modal" }, class: "text-indigo-600 hover:underline" %>
                  </div>
                  <div class="text-[11px] text-slate-500 truncate">
                    <%= record.pantheon&.name %>
                  </div>
                <% elsif record.is_a?(Myth) %>
                  <div class="font-semibold text-slate-900 truncate">
                    <%= link_to "#{record.god&.name} Myth", myth_path(record), data: { turbo_frame: "cluster_modal" }, class: "text-indigo-600 hover:underline" %>
                  </div>
                  <div class="text-[11px] text-slate-500 truncate">
                    <%= record.god&.pantheon&.name %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
