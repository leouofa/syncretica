<% content_for :title, "Archetype & Pattern Reports | Syncretica" %>

<div class="w-full max-w-6xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <div class="flex items-center gap-2">
        <%= link_to "&larr; Cluster Snapshots".html_safe, cluster_snapshots_path, class: "text-xs font-semibold text-indigo-600 hover:text-indigo-500 hover:underline" %>
      </div>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">LLM Archetype & Pattern Reports</h1>
      <p class="mt-1 text-sm text-slate-600">
        Comparative mythological reports generated by LLM analysis of persisted cluster snapshots.
      </p>
    </div>

    <div>
      <%= link_to "Explore Snapshots", cluster_snapshots_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition" %>
    </div>
  </header>

  <!-- Filter tabs -->
  <div class="border-b border-slate-200">
    <nav class="-mb-px flex space-x-6" aria-label="Target Filter">
      <%= link_to cluster_reports_path,
                  class: [
                    "border-b-2 py-2 px-1 text-sm font-medium transition",
                    @target_type.blank? ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700"
                  ].join(" ") do %>
        All Reports (<%= ClusterReport.count %>)
      <% end %>

      <%= link_to cluster_reports_path(target_type: "God"),
                  class: [
                    "border-b-2 py-2 px-1 text-sm font-medium transition",
                    @target_type == "God" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700"
                  ].join(" ") do %>
        God Reports (<%= ClusterReport.joins(:cluster_snapshot).where(cluster_snapshots: { target_type: "God" }).count %>)
      <% end %>

      <%= link_to cluster_reports_path(target_type: "Myth"),
                  class: [
                    "border-b-2 py-2 px-1 text-sm font-medium transition",
                    @target_type == "Myth" ? "border-indigo-600 text-indigo-600" : "border-transparent text-slate-500 hover:text-slate-700"
                  ].join(" ") do %>
        Myth Reports (<%= ClusterReport.joins(:cluster_snapshot).where(cluster_snapshots: { target_type: "Myth" }).count %>)
      <% end %>
    </nav>
  </div>

  <% if @reports.none? %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
      <h3 class="text-base font-semibold text-slate-900">No reports generated yet</h3>
      <p class="mt-1 text-sm text-slate-500">
        Open any saved cluster snapshot to generate comparative pattern and archetype analyses with the LLM agent.
      </p>
      <div class="mt-4">
        <%= link_to "View Saved Snapshots", cluster_snapshots_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition" %>
      </div>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @reports.each do |report| %>
        <%= render "cluster_reports/report_card", report: report, snapshot: report.cluster_snapshot %>
      <% end %>
    </div>
  <% end %>
</div>
