<% content_for :title, "#{@report.title} | Syncretica Reports" %>

<%= turbo_stream_from "cluster_report_#{@report.id}" %>

<div class="w-full max-w-5xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div class="space-y-1 min-w-0 flex-1">
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500">
        <%= link_to "&larr; All Reports".html_safe, cluster_reports_path, class: "text-indigo-600 hover:underline" %>
        <span>&bull;</span>
        <span>Snapshot:</span>
        <%= link_to @report.cluster_snapshot.title, cluster_snapshot_path(@report.cluster_snapshot), class: "text-indigo-600 hover:underline font-bold" %>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
        <%= @report.title %>
        <% if @report.detailed? %>
          <span class="ml-2 align-middle inline-flex items-center rounded-full bg-violet-50 px-2.5 py-0.5 text-xs font-semibold text-violet-700 border border-violet-200">Detailed</span>
        <% end %>
        <% if @report.parent_report.present? %>
          <span class="ml-2 align-middle inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700 border border-slate-200">
            Source: <%= link_to @report.parent_report.title.truncate(40), cluster_report_path(@report.parent_report), class: "text-indigo-600 hover:underline font-semibold" %>
          </span>
        <% end %>
      </h1>
      <p class="text-xs text-slate-500">
        Generated for <strong><%= @report.cluster_snapshot.target_type %></strong> cluster snapshot
        (Level <%= @report.cluster_snapshot.level %>, <%= @report.cluster_snapshot.clusters_count %> clusters, <%= @report.cluster_snapshot.items_count %> items)
        &bull; <%= @report.created_at.strftime("%B %d, %Y at %H:%M UTC") %>
      </p>
    </div>

    <div class="shrink-0 flex items-center gap-3">
      <%= button_to "Delete Report", cluster_report_path(@report), method: :delete, data: { turbo_confirm: "Permanently delete this report?" }, class: "rounded-lg border border-rose-200 bg-white px-3.5 py-2 text-xs font-semibold text-rose-600 shadow-sm hover:bg-rose-50 transition cursor-pointer whitespace-nowrap" %>
    </div>
  </header>

  <!-- Query / Prompt Callout -->
  <div class="rounded-xl border border-indigo-100 bg-indigo-50/40 p-4 text-xs">
    <div class="font-semibold uppercase tracking-wider text-indigo-900 mb-1">Inquiry / Research Prompt</div>
    <div class="text-slate-800 text-sm font-medium">&ldquo;<%= @report.prompt %>&rdquo;</div>
  </div>

  <% if @report.completed? && !@report.detailed? %>
    <!-- Hierarchical Detailed Synthesis -->
    <div class="rounded-xl border border-violet-200 bg-violet-50/40 p-5 space-y-3">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-bold uppercase tracking-wider text-violet-900">Detailed Synthesis</h2>
          <span class="inline-flex items-center rounded-full bg-violet-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-violet-800">Hierarchical</span>
        </div>
        <p class="text-xs text-slate-600 mt-1">
          Run a deep report: this report's per-cluster analyses are aggregated into batches, then synthesized into a longer, richer final report.
        </p>
      </div>

      <%= form_with url: deep_synthesis_cluster_report_path(@report), method: :post, local: true, class: "flex flex-wrap items-end gap-3" do %>
        <div>
          <label for="batch_size" class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 mb-1">Clusters per batch</label>
          <select name="batch_size" id="batch_size" class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-900 shadow-inner focus:border-violet-500 focus:ring-1 focus:ring-violet-500">
            <% [ 3, 5, 10 ].each do |size| %>
              <option value="<%= size %>" <%= "selected" if size == ClusterReport::DEFAULT_BATCH_SIZE %>><%= size %> clusters</option>
            <% end %>
          </select>
        </div>
        <button type="submit" class="rounded-lg bg-violet-600 px-4 py-2 text-xs font-bold text-white shadow-sm hover:bg-violet-500 transition cursor-pointer">
          Generate Detailed Report
        </button>
      <% end %>

      <% if @report.detailed_reports.any? %>
        <div class="mt-4 pt-4 border-t border-violet-200/60 space-y-2">
          <div class="text-[11px] font-bold uppercase tracking-wider text-violet-900">Generated Detailed Reports</div>
          <div class="grid gap-2 sm:grid-cols-2">
            <% @report.detailed_reports.ordered.each do |child| %>
              <div class="flex items-center justify-between rounded-lg bg-white/80 border border-violet-100 px-3 py-2 text-xs">
                <div class="truncate mr-2">
                  <%= link_to child.title, cluster_report_path(child), class: "font-semibold text-violet-900 hover:text-indigo-600 hover:underline" %>
                  <div class="text-[11px] text-slate-500"><%= child.batch_size %> clusters/batch &bull; <%= child.status.capitalize %></div>
                </div>
                <%= link_to "View &rarr;".html_safe, cluster_report_path(child), class: "shrink-0 font-semibold text-violet-700 hover:text-violet-900" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "cluster_reports/report_detail", report: @report %>
</div>
