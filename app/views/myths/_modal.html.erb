<%= turbo_frame_tag "cluster_modal" do %>
  <div data-controller="modal"
       data-action="keydown.esc@window->modal#close"
       class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6"
       role="dialog"
       aria-modal="true"
       aria-labelledby="modal_myth_name">
    <!-- Click backdrop to close -->
    <div class="fixed inset-0 cursor-pointer" data-action="click->modal#close" aria-hidden="true"></div>

    <div class="relative w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl space-y-6 z-10 my-8">
      <!-- Modal Header -->
      <div class="flex items-start justify-between border-b border-slate-100 pb-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
              <%= myth.god.pantheon.name %> Pantheon
            </span>
            <% if myth.embedded? %>
              <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
                Vector Embedded
              </span>
            <% end %>
          </div>
          <h2 id="modal_myth_name" class="mt-2 text-2xl font-bold tracking-tight text-slate-900">
            Myths of <%= myth.god.name %>
          </h2>
        </div>

        <button type="button"
                data-action="click->modal#close"
                class="rounded-lg p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition cursor-pointer"
                aria-label="Close details">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="space-y-4 text-sm text-slate-700 max-h-[60vh] overflow-y-auto pr-1">
        <div class="flex items-center justify-between rounded-lg border border-slate-200 bg-slate-50/70 p-3">
          <span class="text-xs font-medium text-slate-600">Associated Deity:</span>
          <%= link_to "View God (#{myth.god.name}) →",
                      god_path(myth.god),
                      data: { turbo_frame: "cluster_modal" },
                      class: "font-semibold text-xs text-indigo-600 hover:text-indigo-800 underline" %>
        </div>

        <% if myth.themes.is_a?(Hash) && myth.themes.any? %>
          <div class="space-y-3">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Mythical Themes</h3>
            <dl class="divide-y divide-slate-100 rounded-xl border border-slate-200 bg-white p-4">
              <% myth.themes.each do |title, description| %>
                <div class="py-3 first:pt-0 last:pb-0">
                  <dt class="font-semibold text-slate-900 text-sm"><%= title %></dt>
                  <dd class="mt-1 text-xs leading-relaxed text-slate-600 whitespace-pre-line"><%= description %></dd>
                </div>
              <% end %>
            </dl>
          </div>
        <% end %>

        <!-- Vector Embedding Info -->
        <div class="rounded-lg border border-slate-100 bg-slate-50/70 p-3 text-xs text-slate-500">
          <div class="flex items-center justify-between">
            <span>Embedding Model: <strong class="text-slate-700"><%= myth.embedding_model || "None" %></strong></span>
            <span>Dimensions: <strong class="text-slate-700"><%= myth.embedded? ? "#{myth.embedding_dimensions}d" : "Not embedded" %></strong></span>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-between pt-4 border-t border-slate-100">
        <%= link_to "Open Full Myth Page ↗",
                    myth_path(myth),
                    data: { turbo_frame: "_top" },
                    class: "text-xs font-medium text-slate-500 hover:text-indigo-600 hover:underline" %>

        <button type="button"
                data-action="click->modal#close"
                class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition cursor-pointer">
          <span>&larr; Back to Clusters</span>
        </button>
      </div>
    </div>
  </div>
<% end %>
