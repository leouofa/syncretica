<div id="pantheons_list">
  <% if pantheons.any? %>
    <div class="mb-4 text-sm font-medium text-slate-500">
      <%= pluralize(pantheons.size, "pantheon") %> cataloged
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% pantheons.each do |pantheon| %>
        <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md">
          <h2 class="text-lg font-semibold text-slate-900"><%= pantheon.name %></h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= pantheon.description %></p>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
      <h2 class="text-base font-semibold text-slate-900">No pantheons yet</h2>
      <p class="mt-1 text-sm text-slate-600">
        Click <span class="font-medium text-slate-800">Populate Pantheons</span> above to have the agent ask the LLM to find and populate pantheons of gods.
      </p>
    </div>
  <% end %>
</div>
