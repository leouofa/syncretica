<% content_for :title, "Gods | Syncretica" %>

<%= turbo_stream_from PopulateGodsJob::STREAM_NAME %>

<div class="w-full max-w-6xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Gods</h1>
      <p class="mt-2 text-sm text-slate-600">
        Explore deities across every cataloged pantheon or ask the discovery agent to populate and update gods by pantheon.
      </p>
    </div>

    <div class="shrink-0">
      <%= render "pages/populate_controls",
                 target_id: "gods_populate_controls",
                 action_path: populate_gods_path,
                 idle_label: "Populate Gods",
                 running_label: "Discovering Gods...",
                 running: false,
                 status_message: notice,
                 status_kind: (notice.present? ? :info : nil) %>
    </div>
  </header>

  <%= render "pages/gods_list",
             pantheon_groups: @pantheon_groups,
             total_gods_count: @total_gods_count,
             pantheons_count: @pantheons_count %>
</div>
