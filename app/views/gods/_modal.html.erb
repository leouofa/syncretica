<%= turbo_frame_tag "cluster_modal" do %>
  <div data-controller="modal"
       data-action="keydown.esc@window->modal#close"
       class="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 sm:p-6"
       role="dialog"
       aria-modal="true"
       aria-labelledby="modal_god_name">
    <!-- Click backdrop to close -->
    <div class="fixed inset-0 cursor-pointer" data-action="click->modal#close" aria-hidden="true"></div>

    <div class="relative w-full max-w-2xl rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl space-y-6 z-10 my-8">
      <!-- Modal Header -->
      <div class="flex items-start justify-between border-b border-slate-100 pb-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-full bg-indigo-50 border border-indigo-200 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
              <%= god.pantheon.name %> Pantheon
            </span>
            <% if god.embedded? %>
              <span class="inline-flex items-center rounded-full bg-emerald-50 border border-emerald-200 px-2 py-0.5 text-[11px] font-medium text-emerald-700">
                Vector Embedded
              </span>
            <% end %>
          </div>
          <h2 id="modal_god_name" class="mt-2 text-2xl font-bold tracking-tight text-slate-900">
            <%= god.name %>
          </h2>
        </div>

        <button type="button"
                data-action="click->modal#close"
                class="rounded-lg p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition cursor-pointer"
                aria-label="Close details">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="space-y-4 text-sm text-slate-700">
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Description</h3>
          <p class="leading-relaxed text-slate-700 whitespace-pre-line text-sm"><%= god.description %></p>
        </div>

        <% if god.themes.any? %>
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Themes</h3>
            <div class="flex flex-wrap gap-1.5">
              <% god.themes.each do |theme| %>
                <span class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
                  <%= theme %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if god.myth.present? %>
          <div class="rounded-xl border border-indigo-100 bg-indigo-50/50 p-4">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-indigo-800">Associated Myth</h4>
                <p class="text-xs text-indigo-600 mt-0.5">Explore the mythological narratives of <%= god.name %></p>
              </div>
              <%= link_to "View Myth Details →",
                          myth_path(god.myth),
                          data: { turbo_frame: "cluster_modal" },
                          class: "inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-700 hover:text-indigo-900 underline" %>
            </div>
          </div>
        <% end %>

        <!-- Vector Embedding Info -->
        <div class="rounded-lg border border-slate-100 bg-slate-50/70 p-3 text-xs text-slate-500">
          <div class="flex items-center justify-between">
            <span>Embedding Model: <strong class="text-slate-700"><%= god.embedding_model || "None" %></strong></span>
            <span>Dimensions: <strong class="text-slate-700"><%= god.embedded? ? "#{god.embedding_dimensions}d" : "Not embedded" %></strong></span>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-between pt-4 border-t border-slate-100">
        <%= link_to "Open Full God Page ↗",
                    god_path(god),
                    data: { turbo_frame: "_top" },
                    class: "text-xs font-medium text-slate-500 hover:text-indigo-600 hover:underline" %>

        <button type="button"
                data-action="click->modal#close"
                class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition cursor-pointer">
          <span>&larr; Back to Clusters</span>
        </button>
      </div>
    </div>
  </div>
<% end %>
