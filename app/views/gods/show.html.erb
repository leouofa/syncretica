<% if turbo_frame_request? && turbo_frame_request_id.in?(%w[cluster_modal modal]) %>
  <%= render "gods/modal", god: @god %>
<% else %>
  <% content_for :title, "#{@god.name} | Gods | Syncretica" %>

  <%= turbo_stream_from GenerateEmbeddingJob.stream_name_for(@god) %>

  <div class="w-full max-w-4xl mx-auto space-y-8 pb-16">
    <div class="flex items-center justify-between">
      <%= link_to "← Back to Gods", gods_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <% if @god.myth.present? %>
        <%= link_to "View Myth →", myth_path(@god.myth), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
      <% end %>
    </div>

    <header class="border-b border-slate-200 pb-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600"><%= @god.pantheon.name %> Pantheon</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900"><%= @god.name %></h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600"><%= @god.description %></p>

      <% if @god.themes.any? %>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Themes for <%= @god.name %>">
          <% @god.themes.each do |theme| %>
            <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700">
              <%= theme %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <%= render "shared/embedding_panel",
               record: @god,
               action_path: generate_embedding_god_path(@god),
               running: false,
               status_message: notice,
               status_kind: (notice.present? ? :info : nil) %>
  </div>
<% end %>
